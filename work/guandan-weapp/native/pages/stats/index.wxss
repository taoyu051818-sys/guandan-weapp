.page{min-height:100vh;box-sizing:border-box;padding:54rpx 38rpx;background:radial-gradient(ellipse at top,#193f34,#0b0c10 72%);color:#f8f3df}.title{display:block;margin-bottom:58rpx;text-align:center;color:#f3d77e;font-size:46rpx;font-weight:700;letter-spacing:7rpx}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20rpx}.metric{padding:34rpx 18rpx;border:1rpx solid rgba(255,255,255,.12);border-radius:20rpx;background:rgba(255,255,255,.06);text-align:center}.metric text,.recent text{display:block;color:#b8c8c0;font-size:22rpx;letter-spacing:2rpx}.metric strong{display:block;margin-top:18rpx;color:#f3d77e;font-size:52rpx}.wide{grid-column:span 2}.recent{margin-top:36rpx;padding:28rpx;border:1rpx solid rgba(212,175,55,.25);border-radius:20rpx;background:rgba(0,0,0,.25)}.recent text{margin:12rpx 0;line-height:1.5}
