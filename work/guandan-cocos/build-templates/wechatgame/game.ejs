globalThis.__GUANDAN_BUILD_TARGET__ = 'wechatgame';
/* guandan-runtime-config:start */
globalThis.__GUANDAN_RUNTIME_CONFIG__ = Object.freeze({"version":1,"lobbyEndpoint":"wss://api.yutechhn.cn/guandan/weapp","platformEndpoint":"https://api.yutechhn.cn/guandan","platformAllowDevelopmentLogin":false,"platformAllowInsecureEndpoint":false,"platformAllowInsecureGameEndpoint":false});
/* guandan-runtime-config:end */
function __initApp () {  // init app
globalThis.__wxRequire = require;  // FIX: require cannot work in separate engine 
require('./web-adapter');
const firstScreen = require('./first-screen');

<%- include(cocosTemplate, {}) %>

// Adapt for IOS, swap if opposite
const info = wx.getSystemInfoSync();
if (canvas){
    var _w = canvas.width;
    var _h = canvas.height;
    if (info.screenWidth < info.screenHeight) {
        if (canvas.width > canvas.height) {
            _w = canvas.height;
            _h = canvas.width;
        }
    } else {
        if (canvas.width < canvas.height) {
            _w = canvas.height;
            _h = canvas.width;
        }
    }
    canvas.width = _w;
    canvas.height = _h;
}
// Adjust initial canvas size
if (canvas && window.devicePixelRatio >= 2) {canvas.width *= info.devicePixelRatio; canvas.height *= info.devicePixelRatio;}

const importMap = require("<%= importMapFile%>").default;
System.warmup({
    importMap,
    importMapUrl: '<%= importMapFile%>',
    defaultHandler: (urlNoSchema) => {
        require('.' + urlNoSchema);
    },
    handlers: {
        'plugin:': (urlNoSchema) => {
            requirePlugin(urlNoSchema);
        },
        'project:': (urlNoSchema) => {
            require(urlNoSchema);
        },
    },
});

function loadAndStartApplication() {
    return System.import('<%= applicationJs %>');
}

function createApplication(module) {
    return firstScreen.setProgress(0.2).then(() => Promise.resolve(module));
}

function constructApplication({ Application }) {
    return new Application();
}

function initializeApplication(application) {
    return firstScreen.setProgress(0.4).then(() => Promise.resolve(application));
}

function handleLoadingFailure(err) {
    console.error('[game] Failed to load or initialize the game.', err);
    return firstScreen.showFailure('\u8d44\u6e90\u52a0\u8f7d\u5931\u8d25\uff0c\u8bf7\u70b9\u51fb\u5c4f\u5e55\u91cd\u8bd5', () => {
        return runApplicationPipeline();
    });
}

function runApplicationPipeline() {
    return loadAndStartApplication().then(createApplication).then(constructApplication).then(initializeApplication).then((application) => {
        return onApplicationCreated(application);
    });
}

firstScreen.start('<%= alpha %>', '<%= antialias %>', '<%= useWebgl2 %>').then(() => {
    return runApplicationPipeline();
}).catch((err) => {
    return handleLoadingFailure(err);
});

function startApplication(application) {
    return Promise.resolve().then(() => application.start()).then(() => {
        firstScreen.clearFailure();
    }).catch((err) => {
        console.error('[game] Cocos engine failed to start.', err);
        return firstScreen.showFailure('\u5f15\u64ce\u542f\u52a8\u5931\u8d25\uff0c\u8bf7\u70b9\u51fb\u5c4f\u5e55\u91cd\u8bd5', () => {
            return startApplication(application);
        });
    });
}

function onApplicationCreated(application) {
    return System.import('cc').then((module) => {
        return firstScreen.setProgress(0.6).then(() => Promise.resolve(module));
    }).then((cc) => {
        require('./engine-adapter');
        return application.init(cc);
    }).then(() => {
        // Match Creator 3.8.8: release the first-screen renderer before the
        // engine claims WebGL state. end() keeps the final framebuffer intact.
        return firstScreen.end();
    }).then(() => {
        return startApplication(application);
    });
}

}  // init app

// NOTE: on WeChat Android end, we can only get the correct screen size at the second tick of game.
var sysInfo = wx.getSystemInfoSync();
if (sysInfo.platform.toLocaleLowerCase() === 'android') {
    GameGlobal.requestAnimationFrame (__initApp);
} else {
    __initApp();
}
