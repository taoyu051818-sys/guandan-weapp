.page{min-height:100vh;box-sizing:border-box;padding:70rpx 34rpx;background:radial-gradient(ellipse at top,#193f34,#0b0c10 72%);color:#f8f3df;text-align:center}.title{display:block;color:#f3d77e;font-size:50rpx;font-weight:800;letter-spacing:9rpx}.lead{display:block;margin:28rpx 32rpx;color:#b9cbc2;font-size:24rpx;line-height:1.7}.deck{position:relative;height:250rpx;margin:72rpx auto 42rpx;width:180rpx}.back{position:absolute;left:36rpx;top:10rpx;width:116rpx;height:170rpx;border:2rpx solid #d4af37;border-radius:12rpx;background:repeating-linear-gradient(45deg,#102721,#102721 10rpx,#193d34 10rpx,#193d34 20rpx);box-shadow:0 10rpx 20rpx rgba(0,0,0,.4);color:#d4af37;font-size:21rpx;line-height:170rpx}.draw-tip{position:absolute;bottom:0;left:0;right:0;color:#f3d77e;font-size:27rpx}.draws{display:flex;justify-content:space-between;align-items:flex-end;margin-top:30rpx}.draw{width:23%;color:#cbd9d2;font-size:20rpx}.draw-card{height:132rpx;margin-top:16rpx;padding:14rpx;box-sizing:border-box;border:2rpx solid #d4af37;border-radius:10rpx;background:#fffdf0;color:#111;display:flex;flex-direction:column;justify-content:space-between;text-align:left;font-size:32rpx;font-weight:bold}.draw-card text:last-child{align-self:flex-end}.red{color:#b91c1c}.result{margin:68rpx 20rpx 0;color:#f3d77e;font-size:31rpx}.result button{margin-top:36rpx}
