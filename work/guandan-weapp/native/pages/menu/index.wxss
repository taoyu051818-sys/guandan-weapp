.menu{min-height:100vh;position:relative;overflow:hidden;box-sizing:border-box;padding:170rpx 62rpx 80rpx;background:radial-gradient(ellipse at 50% 20%,#193f34,#0b0c10 66%);color:#fffff0}.glow{position:absolute;width:460rpx;height:460rpx;border-radius:50%;filter:blur(90rpx);opacity:.22}.glow-a{top:-180rpx;left:-180rpx;background:#d4af37}.glow-b{right:-220rpx;bottom:-180rpx;background:#8b2635}.hero{position:relative;z-index:1;text-align:center;margin-bottom:120rpx}.brand{display:block;color:#f5d978;font-size:78rpx;font-weight:900;letter-spacing:14rpx;text-shadow:0 0 32rpx rgba(212,175,55,.55)}.rule{height:2rpx;margin:30rpx 90rpx;background:linear-gradient(90deg,transparent,#d4af37,transparent)}.english{font-size:21rpx;letter-spacing:8rpx;color:#d7c37a}.menu-actions,.mode-list{position:relative;z-index:1}.menu button,.mode-list button{margin:24rpx 0;border:1rpx solid rgba(212,175,55,.3);border-radius:18rpx;background:rgba(30,38,42,.76);color:#f8f0d1;font-weight:700;letter-spacing:4rpx;font-size:30rpx}.menu .primary{background:linear-gradient(90deg,#a47920,#d4af37);color:#16130c}.online-note{display:block;margin:34rpx 18rpx;color:#93aaa0;text-align:center;font-size:22rpx;line-height:1.7}.mode-title{display:block;margin-bottom:28rpx;text-align:center;color:#f5d978;font-size:40rpx;font-weight:700;letter-spacing:5rpx}.mode-list button{text-align:left;padding:26rpx 30rpx}.mode-list .sub{display:block;margin-top:10rpx;color:#aebbb5;font-size:21rpx;font-weight:400;letter-spacing:1rpx}.mode-list .back{text-align:center;background:transparent;color:#cbd7d1}
