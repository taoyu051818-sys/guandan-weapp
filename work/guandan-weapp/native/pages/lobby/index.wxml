<view class="page"><text class="title">好友房联机</text><text class="notice">生产版必须填写已备案、已配置为微信合法通信域名的 wss:// 地址。</text><input class="input" placeholder="wss://example.com/weapp" value="{{url}}" data-key="url" bindinput="input"/><button wx:if="{{!connected}}" type="primary" bindtap="connect">连接服务</button><view wx:else><view wx:if="{{!inRoom}}"><input class="input" placeholder="创建房间：6 位房间号" value="{{roomId}}" data-key="roomId" bindinput="input"/><button bindtap="create">创建好友房</button><input class="input" placeholder="加入房间号" value="{{joinId}}" data-key="joinId" bindinput="input"/><button bindtap="join">加入好友房</button><view wx:for="{{rooms}}" wx:key="roomId" class="room"><text>{{item.hostName}} · {{item.roomId}} · {{item.playerCount}}/4</text><button size="mini" data-id="{{item.roomId}}" bindtap="join">加入</button></view></view><view wx:else class="waiting"><text>房间 {{roomId}}</text><text>我的座位：{{mine}}</text><text>已入座：{{memberText}}</text><button wx:if="{{mine==='p1'}}" type="primary" bindtap="start">四人到齐后开始</button></view></view><text class="message">{{message}}</text></view>
