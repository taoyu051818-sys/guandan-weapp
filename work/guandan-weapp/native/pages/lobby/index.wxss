.page{min-height:100vh;box-sizing:border-box;padding:54rpx 38rpx;background:radial-gradient(ellipse at top,#193f34,#0b0c10 72%);color:#f8f3df}.title{display:block;margin-bottom:24rpx;text-align:center;color:#f3d77e;font-size:46rpx;font-weight:700;letter-spacing:7rpx}.notice,.message{display:block;margin:24rpx 0;color:#b9cbc2;font-size:23rpx;line-height:1.6}.input{height:78rpx;margin:22rpx 0;padding:0 22rpx;border:1rpx solid rgba(212,175,55,.4);border-radius:14rpx;background:rgba(255,255,255,.08);color:#fff}.page button{margin:16rpx 0}.room{display:flex;align-items:center;justify-content:space-between;margin-top:20rpx;padding:22rpx;border-radius:14rpx;background:rgba(255,255,255,.07);font-size:24rpx}.room button{margin:0}.waiting{display:flex;flex-direction:column;gap:22rpx;margin-top:42rpx;padding:36rpx;border:1rpx solid rgba(212,175,55,.35);border-radius:20rpx;background:rgba(0,0,0,.25);font-size:28rpx;text-align:center}
