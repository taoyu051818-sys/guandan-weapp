<view class="page"><text class="title">摸牌定庄</text><text class="lead">红牌为我方队伍，黑牌为对方队伍；点数最大者先手。</text><view class="deck" wx:if="{{!drawing}}" bindtap="draw"><view wx:for="{{[1,2,3,4,5,6,7]}}" wx:key="*this" class="back" style="transform:translateX({{(index-3)*12}}rpx) rotate({{(index-3)*2}}deg)"><text>掼蛋</text></view><text class="draw-tip">点击抽牌</text></view><view class="draws"><view wx:for="{{['p3','p4','p1','p2']}}" wx:key="*this" class="draw"><text>{{item==='p1'?'玩家':(item==='p2'?'电脑2':(item==='p3'?'电脑3':'电脑4'))}}</text><view class="draw-card {{cards[item].red?'red':''}}"><text>{{cards[item] ? cards[item].rank : '?'}}</text><text>{{cards[item] ? cards[item].suit : ''}}</text></view></view></view><view wx:if="{{ready}}" class="result"><text>{{dealerName}} 获得庄家和首发权</text><button type="primary" bindtap="begin">进入对局</button></view></view>
