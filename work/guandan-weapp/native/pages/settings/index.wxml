<view class="page"><text class="title">游戏设置</text><view class="section"><text class="label">AI 难度</text><view class="choices"><button data-key="difficulty" data-value="easy" bindtap="choose" class="{{settings.difficulty==='easy'?'on':''}}">简单</button><button data-key="difficulty" data-value="medium" bindtap="choose" class="{{settings.difficulty==='medium'?'on':''}}">中等</button><button data-key="difficulty" data-value="hard" bindtap="choose" class="{{settings.difficulty==='hard'?'on':''}}">困难</button><button data-key="difficulty" data-value="master" bindtap="choose" class="{{settings.difficulty==='master'?'on':''}}">大师</button></view></view><view class="section"><text class="label">手牌排序</text><view class="choices two"><button data-key="sortOrder" data-value="desc" bindtap="choose" class="{{settings.sortOrder==='desc'?'on':''}}">大牌在左</button><button data-key="sortOrder" data-value="asc" bindtap="choose" class="{{settings.sortOrder==='asc'?'on':''}}">小牌在左</button></view></view><view class="section"><text class="label">规则预设</text><view class="choices two"><button data-key="rulePreset" data-value="classic" bindtap="choose" class="{{settings.rulePreset==='classic'?'on':''}}">经典规则</button><button data-key="rulePreset" data-value="tournament" bindtap="choose" class="{{settings.rulePreset==='tournament'?'on':''}}">竞技规则</button></view></view><view class="section"><text class="label">视觉主题</text><view class="choices two"><button data-key="visualTheme" data-value="luxury" bindtap="choose" class="{{settings.visualTheme==='luxury'?'on':''}}">华丽牌桌</button><button data-key="visualTheme" data-value="compact" bindtap="choose" class="{{settings.visualTheme==='compact'?'on':''}}">竞技简洁</button></view></view><view class="switch-row"><text>游戏音效</text><switch checked="{{settings.soundEnabled}}" color="#d4af37" data-key="soundEnabled" bindchange="toggle"/></view><view class="switch-row"><text>背景音乐</text><switch checked="{{settings.bgmEnabled}}" color="#d4af37" data-key="bgmEnabled" bindchange="toggle"/></view></view>
