.page{min-height:100vh;box-sizing:border-box;padding:48rpx 34rpx;background:radial-gradient(ellipse at top,#193f34,#0b0c10 72%);color:#f7f0d4}.title{display:block;margin:10rpx 0 54rpx;text-align:center;color:#f3d77e;font-size:46rpx;font-weight:700;letter-spacing:7rpx}.section{margin-bottom:42rpx;padding-bottom:36rpx;border-bottom:1rpx solid rgba(255,255,255,.1)}.label{display:block;margin-bottom:22rpx;color:#d8c677;font-size:25rpx;letter-spacing:4rpx}.choices{display:grid;grid-template-columns:repeat(4,1fr);gap:12rpx}.choices.two{grid-template-columns:repeat(2,1fr)}.choices button{padding:18rpx 5rpx;border:1rpx solid rgba(255,255,255,.15);border-radius:12rpx;background:rgba(255,255,255,.06);color:#dce8e2;font-size:23rpx}.choices .on{border-color:#d4af37;background:rgba(212,175,55,.18);color:#f5dc82}.switch-row{display:flex;justify-content:space-between;align-items:center;margin:34rpx 0;padding:24rpx;border-radius:16rpx;background:rgba(255,255,255,.06);font-size:27rpx}
