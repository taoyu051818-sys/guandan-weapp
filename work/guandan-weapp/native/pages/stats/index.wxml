<view class="page"><text class="title">玩家数据看板</text><view class="grid"><view class="metric"><text>当前积分</text><strong>{{stats.elo}}</strong></view><view class="metric"><text>总场数</text><strong>{{stats.gamesPlayed}}</strong></view><view class="metric"><text>胜率</text><strong>{{winRate}}%</strong></view><view class="metric"><text>头游次数</text><strong>{{stats.firstPlaceFinishes}}</strong></view><view class="metric wide"><text>炸弹使用次数</text><strong>{{stats.bombsPlayed}}</strong></view></view><view wx:if="{{stats.recentMatch}}" class="recent"><text>最近一局</text><text>胜方：{{stats.recentMatch.winnerTeam==='teamA' ? '我方' : '对方'}} · 级别变化：{{stats.recentMatch.levelUp}}</text><text>当前级别：{{stats.recentMatch.currentLevel}} · 比分 {{stats.recentMatch.scores.teamA}}:{{stats.recentMatch.scores.teamB}}</text></view></view>
