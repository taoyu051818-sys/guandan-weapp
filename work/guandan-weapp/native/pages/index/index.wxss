.table { min-height: 100vh; position: relative; box-sizing: border-box; padding: 26rpx 20rpx; background: radial-gradient(ellipse at center, #175a45, #0b0c10 75%); }
.header, .actions { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.title { font-size: 42rpx; font-weight: 700; letter-spacing: 4rpx; color: #f3e5ab; text-shadow: 0 2rpx 8rpx #000; }
.level { color: #f3e5ab; }
.leave { padding: 8rpx 14rpx; border: 1rpx solid rgba(255,255,255,.25); border-radius: 12rpx; color: #c8d7cd; font-size: 20rpx; }
.score { display: flex; justify-content: center; gap: 24rpx; margin-top: 12rpx; color: #d7e4dd; font-size: 22rpx; }
.player { position: absolute; display: flex; gap: 12rpx; padding: 12rpx 16rpx; border-radius: 16rpx; background: rgba(0,0,0,.42); border: 1rpx solid rgba(255,255,255,.14); color: #e7eee8; font-size: 24rpx; }
.chat { position: absolute; z-index: 2; max-width: 240rpx; padding: 9rpx 14rpx; border: 1rpx solid rgba(212,175,55,.55); border-radius: 16rpx; background: #fffdf0; color: #27302b; font-size: 20rpx; line-height: 1.3; white-space: nowrap; transform: translateY(-50rpx); }
.top { top: 146rpx; left: 50%; transform: translateX(-50%); }
.left { top: 44%; left: 20rpx; flex-direction: column; }
.right { top: 44%; right: 20rpx; flex-direction: column; }
.self { position: relative; margin: 330rpx auto 0; width: 310rpx; justify-content: space-between; }
.active { border-color: #d4af37; box-shadow: 0 0 18rpx rgba(212,175,55,.55); }
.open-hand { position: absolute; top: 210rpx; left: 50%; transform: translateX(-50%); display: flex; width: 600rpx; overflow: hidden; justify-content: center; }
.mini-card { flex: none; width: 37rpx; height: 58rpx; margin-left: -10rpx; padding: 4rpx; box-sizing: border-box; display: flex; flex-direction: column; justify-content: space-between; border: 1rpx solid #d4af37; border-radius: 5rpx; background: #fffff0; color: #141414; font-size: 17rpx; }
.mini-card text:last-child, .played-card text:last-child { align-self: flex-end; }
.play { height: 260rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14rpx; color: #f3e5ab; font-size: 28rpx; }
.played-cards { display: flex; max-width: 390rpx; overflow: hidden; justify-content: center; }
.played-card { flex: none; width: 56rpx; height: 86rpx; margin-left: -18rpx; padding: 6rpx; box-sizing: border-box; display: flex; flex-direction: column; justify-content: space-between; border: 2rpx solid #d4af37; border-radius: 7rpx; background: #fffff0; color: #141414; font-size: 22rpx; font-weight: 700; box-shadow: 0 8rpx 14rpx rgba(0,0,0,.35); }
.effect { color: #f3d77e; font-size: 30rpx; font-weight: 800; text-shadow: 0 0 16rpx rgba(212,175,55,.7); }
.hint { font-size: 23rpx; color: #d7e4dd; text-align: center; }
.hand { display: flex; flex-wrap: nowrap; justify-content: center; padding: 18rpx 0 28rpx; overflow: hidden; }
.card { flex: none; width: 74rpx; height: 112rpx; margin-left: -16rpx; padding: 9rpx; box-sizing: border-box; display: flex; flex-direction: column; justify-content: space-between; background: #fffff0; border: 2rpx solid #d4af37; border-radius: 8rpx; color: #141414; font-weight: 700; transition: transform .16s; }
.rank { font-size: 27rpx; }.suit { font-size: 28rpx; align-self: flex-end; }.red { color: #b91c1c; }
.selected { transform: translateY(-22rpx); box-shadow: 0 10rpx 16rpx rgba(0,0,0,.55); }
.actions { margin-top: 10rpx; }.actions button { font-size: 25rpx; }
.chat-panel { position: absolute; z-index: 9; bottom: 180rpx; left: 24rpx; width: 260rpx; padding: 16rpx; border: 1rpx solid rgba(212,175,55,.4); border-radius: 16rpx; background: rgba(11,12,16,.94); box-shadow: 0 12rpx 32rpx rgba(0,0,0,.4); }
.chat-panel button { margin: 8rpx 0; border: 0; background: rgba(255,255,255,.08); color: #f3e5ab; font-size: 21rpx; text-align: left; }
.mask { position: fixed; z-index: 10; inset: 0; display: flex; align-items: center; justify-content: center; padding: 40rpx; background: rgba(0,0,0,.72); }
.dialog { width: 100%; box-sizing: border-box; padding: 44rpx 34rpx; border: 2rpx solid rgba(212,175,55,.66); border-radius: 28rpx; background: linear-gradient(145deg,#173d31,#11151a); box-shadow: 0 18rpx 60rpx rgba(0,0,0,.55); color: #f5ecd0; }
.dialog-title, .victory { display: block; text-align: center; font-size: 42rpx; font-weight: 700; letter-spacing: 5rpx; color: #f3d77e; }
.dialog-copy { display: block; margin: 22rpx 0; color: #d7e4dd; line-height: 1.7; text-align: center; }
.tribute-row { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12rpx; margin: 16rpx 0; padding: 18rpx; border-radius: 14rpx; background: rgba(255,255,255,.07); font-size: 22rpx; }
.dialog button { margin-top: 28rpx; }.upgrade { display: block; margin: 26rpx 0; text-align: center; font-size: 64rpx; font-weight: 700; color: #f3d77e; }.rankline { display: block; margin-bottom: 22rpx; text-align: center; color: #c8d7cd; font-size: 23rpx; }
.compact { padding: 16rpx 12rpx; background: #123d30; }.compact .play { height: 200rpx; }.compact .self { margin-top: 260rpx; }.compact .card { width: 64rpx; height: 98rpx; }.compact .top { top: 108rpx; }.compact .open-hand { top: 176rpx; }
