<view class="table {{theme==='compact'?'compact':''}}">
  <view class="header"><text class="title">掼蛋大师</text><text wx:if="{{isMultiplayer}}" class="leave" bindtap="leaveOnline">离开房间</text><text class="level">当前级牌：{{level}}</text></view>
  <view class="score"><text>我方 {{teamLevels.teamA}} 级 · {{scores.teamA}} 分</text><text>对方 {{teamLevels.teamB}} 级 · {{scores.teamB}} 分</text></view>
  <view class="player top {{turn===seats.top?'active':''}}"><text>{{names.top}}</text><text wx:if="{{chats.top}}" class="chat">{{chats.top}}</text><text wx:if="{{!showP3}}">{{counts.top}} 张</text><text wx:else>明牌</text></view>
  <view class="player left {{turn===seats.left?'active':''}}"><text>{{names.left}}</text><text wx:if="{{chats.left}}" class="chat">{{chats.left}}</text><text>{{counts.left}} 张</text></view>
  <view class="player right {{turn===seats.right?'active':''}}"><text>{{names.right}}</text><text wx:if="{{chats.right}}" class="chat">{{chats.right}}</text><text>{{counts.right}} 张</text></view>
  <view wx:if="{{showP3}}" class="open-hand"><view wx:for="{{p3Hand}}" wx:key="id" class="mini-card {{item.red?'red':''}}"><text>{{item.rank}}</text><text>{{item.suit}}</text></view></view>
  <view class="play"><text>{{lastPlay}}</text><view wx:if="{{lastCards.length}}" class="played-cards"><view wx:for="{{lastCards}}" wx:key="id" class="played-card {{item.red?'red':''}}"><text>{{item.rank}}</text><text>{{item.suit}}</text></view></view><text wx:if="{{effect}}" class="effect">{{effect==='Bomb'?'💥 炸弹！':(effect==='Rocket'?'🚀 火箭！':(effect==='StraightFlush'?'✨ 同花顺！':effect))}}</text><text class="hint">{{hint}}</text></view>
  <view class="player self {{turn===seats.self?'active':''}}"><text>{{names.self}}</text><text wx:if="{{chats.self}}" class="chat">{{chats.self}}</text><text>{{counts.self}} 张</text></view>
  <view class="hand"><view wx:for="{{hand}}" wx:key="id" class="card {{item.selected ? 'selected' : ''}} {{item.red ? 'red' : ''}}" data-id="{{item.id}}" bindtap="toggle"><text class="rank">{{item.rank}}</text><text class="suit">{{item.suit}}</text></view></view>
  <view wx:if="{{phase==='playing'}}" class="actions"><button wx:if="{{!isMultiplayer}}" type="primary" bindtap="deal">重新开局</button><button bindtap="toggleChat">聊天</button><button disabled="{{!selectedCount}}" bindtap="play">出牌</button><button bindtap="pass">不要</button></view>
  <view wx:if="{{showChat}}" class="chat-panel"><button data-text="快点啊，我等的花儿都谢了" data-voice="chat_hurry" bindtap="sendChat">快点啊</button><button data-text="你的牌打得也太好了" data-voice="chat_good" bindtap="sendChat">打得漂亮</button><button data-text="交个朋友吧" data-voice="chat_friend" bindtap="sendChat">交个朋友</button><button data-text="不要走，决战到天亮" data-voice="chat_stay" bindtap="sendChat">决战到天亮</button></view>

  <view wx:if="{{phase==='tribute'}}" class="mask">
    <view class="dialog tribute-dialog"><text class="dialog-title">{{tribute.anti ? '抗贡成立' : (tribute.phase==='tributing' ? '进贡阶段' : (tribute.phase==='returning' ? '还贡阶段' : '贡还完成'))}}</text><text class="dialog-copy">{{tribute.anti ? '本局无需进贡，按规则由上游方先手。' : (tribute.phase==='tributing' ? '进贡方须交出最大牌（红桃级牌除外）。' : (tribute.phase==='returning' ? '还贡牌点数不高于 10。' : '请开始本局。'))}}</text><view wx:for="{{tribute.actions}}" wx:key="from" class="tribute-row"><text>{{item.from}} → {{item.to}}</text><text>进：{{item.card ? item.card.rank + item.card.suit : '等待'}}</text><text>还：{{item.returnCard ? item.returnCard.rank + item.returnCard.suit : '等待'}}</text></view><button wx:if="{{!tribute.anti && tribute.phase!=='done'}}" disabled="{{selectedCount!==1}}" bindtap="confirmTribute">确认选牌</button><button wx:if="{{tribute.anti || tribute.phase==='done'}}" type="primary" bindtap="finishTribute">开始本局</button></view>
  </view>

  <view wx:if="{{phase==='settlement'}}" class="mask"><view class="dialog settlement"><text class="victory">{{settlement.winnerTeam==='teamA' ? '本局胜利' : '本局失利'}}</text><text class="dialog-copy">{{settlement.message}}</text><text class="upgrade">{{settlement.levelUp>=0 ? '+' : ''}}{{settlement.levelUp}} 级</text><text class="rankline">{{settlement.rankText}}</text><button type="primary" bindtap="nextRound">{{settlement.isGameWon ? '重新开局' : '继续下一局'}}</button></view></view>
</view>
