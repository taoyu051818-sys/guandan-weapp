.page{min-height:100vh;box-sizing:border-box;padding:54rpx 38rpx;background:radial-gradient(ellipse at top,#193f34,#0b0c10 72%);color:#f8f3df}.title{display:block;margin-bottom:64rpx;text-align:center;color:#f3d77e;font-size:46rpx;font-weight:700;letter-spacing:7rpx}.panel{min-height:440rpx;box-sizing:border-box;padding:46rpx 38rpx;border:1rpx solid rgba(212,175,55,.42);border-radius:26rpx;background:rgba(16,28,27,.82)}.counter{display:block;color:#b6c8c0;font-size:22rpx}.step-title{display:block;margin:40rpx 0 28rpx;color:#f3d77e;font-size:38rpx;font-weight:700;letter-spacing:4rpx}.content{display:block;color:#e0ebe4;font-size:29rpx;line-height:1.9}.actions{display:flex;justify-content:space-between;margin-top:54rpx;gap:24rpx}.actions button{width:46%;font-size:27rpx}
